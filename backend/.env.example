APP_ENV=development
DEMO_MODE=true
# Paste your Neon connection URL into private backend/.env or Render secrets.
# Standard postgresql:// URLs are automatically normalized to Psycopg 3.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=verify-full

REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=
JWT_SECRET=replace-with-a-long-random-signing-secret
QUALIFICATION_THRESHOLD=65
DAILY_OUTREACH_LIMIT=20

# Development login. Change before production.
LOGIN_EMAIL=contactsales@vtabsquare.com
LOGIN_PASSWORD=

# Phase 1 native demo (never enable demo auth in production)
DEMO_AUTH=false
DEMO_OTP=123456
AI_PROVIDER=local
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
INITIALIZE_SCHEMA=false
SCHEDULER_ENABLED=false

# Read-only company materials. Obtain Google owner consent separately.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_IDS=
# Fine-grained token: selected repositories, contents read only.
GITHUB_READ_TOKEN=
