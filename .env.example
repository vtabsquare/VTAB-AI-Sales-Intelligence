APP_ENV=development
DEMO_MODE=true
# Default SQL Server instance with Windows Authentication:
DATABASE_URL=mssql+pyodbc://@localhost/VTABOpportunityAgent?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# For a named SQLEXPRESS instance, URL-encode the backslash as %5C:
# DATABASE_URL=mssql+pyodbc://@localhost%5CSQLEXPRESS/VTABOpportunityAgent?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=
JWT_SECRET=replace-with-a-long-random-signing-secret
QUALIFICATION_THRESHOLD=65
DAILY_OUTREACH_LIMIT=20

# Development login. Change before production.
LOGIN_EMAIL=contactsales@vtabsquare.com
LOGIN_PASSWORD=

# Phase 1 native demo (never enable demo auth in production)
DEMO_AUTH=false
DEMO_OTP=123456
AI_PROVIDER=local
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
INITIALIZE_SCHEMA=false
SCHEDULER_ENABLED=false
